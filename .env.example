# BasketBest UK — Environment Variables
# Copy to .env.local and fill in values

# Supabase (get from supabase.com > your project > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (get from stripe.com > Developers > API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Server-side (Supabase Edge Functions only — never in VITE_ prefix) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# WORKER_SECRET=some-random-secret-shared-with-fly-workers
# OPENAI_API_KEY=sk-... (for pgvector product embeddings)
