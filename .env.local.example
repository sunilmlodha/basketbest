# BasketBest UK — Local Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API

# Public URL for this Supabase project (safe to expose in browser bundles)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — used by the frontend (read-only RLS enforced)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role key — server-side ONLY (bypasses RLS; never in VITE_ prefix)
# Used by: import-prices.ts script, price-feed Edge Function, comparison-engine
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Trolley.co.uk API ─────────────────────────────────────────────────────────
# Real-time UK grocery price aggregator (tesco, asda, sainsburys, morrisons, ocado, waitrose)
# Sign up at: https://dev.trolley.co.uk
# Used by: supabase/functions/price-feed (Edge Function)
TROLLEY_API_KEY=your_key_here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from: stripe.com → Developers → API keys
# Use test-mode keys (pk_test_ / sk_test_) for local development

# Publishable key — used by the frontend Stripe.js integration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-side ONLY (never in VITE_ prefix)
# Used by: stripe-checkout and stripe-webhook Edge Functions
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — validates webhook payloads from Stripe
# Get from: stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Internal worker auth ───────────────────────────────────────────────────────
# Shared secret between Supabase Edge Functions and any Fly.io workers.
# Generate with: openssl rand -hex 32
WORKER_SECRET=replace-with-a-random-secret-at-least-32-chars

# ── Optional ──────────────────────────────────────────────────────────────────
# OpenAI API key — only needed if you use pgvector product-embedding features
# OPENAI_API_KEY=sk-...
